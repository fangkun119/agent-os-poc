<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.agentos</groupId>
    <artifactId>agentos</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>agentos-boot</artifactId>
  <name>agentos-boot</name>
  <description>Spring Boot 启动模块（TS 10）：主类、自动配置、依赖聚合。打包 fat JAR，java -jar 启动；扩展阶段经 GraalVM Native Image 编译原生二进制。</description>

  <dependencies>
    <dependency>
      <groupId>com.agentos</groupId>
      <artifactId>agentos-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.agentos</groupId>
      <artifactId>agentos-provider</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.agentos</groupId>
      <artifactId>agentos-memory</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.agentos</groupId>
      <artifactId>agentos-tool</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.agentos</groupId>
      <artifactId>agentos-channel-cli</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.agentos</groupId>
      <artifactId>agentos-web</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.agentos</groupId>
      <artifactId>agentos-storage</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.agentos</groupId>
      <artifactId>agentos-cli</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
